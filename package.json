{
  "name": "@operstack/gates",
  "version": "0.2.1",
  "description": "16 automated quality gates for content sites: characters, MDX compile, frontmatter, structure, duplication, shared sentences, hollow sections, internal links, link semantics, meta, readability, images, redirects, AI index, unsourced claims, agent surface.",
  "type": "module",
  "bin": {
    "gates": "bin/gates.mjs"
  },
  "exports": {
    ".": "./src/index.mjs"
  },
  "files": [
    "bin",
    "src",
    "docs",
    "rules",
    "test/fixtures",
    "gates.config.example.json",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node test/check-fixtures.mjs",
    "gates": "node bin/gates.mjs",
    "demo": "node bin/gates.mjs --demo"
  },
  "keywords": [
    "seo",
    "aeo",
    "geo",
    "astro",
    "mdx",
    "content-quality",
    "programmatic-seo",
    "llms-txt",
    "site-audit"
  ],
  "author": "OperStack",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@mdx-js/mdx": "^3.1.0"
  }
}
